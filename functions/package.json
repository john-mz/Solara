{
  "name": "techos-rentables-functions",
  "version": "1.0.0",
  "description": "Cloud Functions para sincronización y telemetría de plantas solares",
  "main": "lib/index.js",
  "scripts": {
    "lint": "echo \"Skip linting for hackathon\"",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill": "tsx scripts/backfillHistory.ts"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.8",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^15.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3"
  },
  "private": true
}
